class Solution {
    public int[] asteroidCollision(int[] asteroids) {
        int[] stack = new int[asteroids.length];
        int top = -1;

        for (int i = 0; i < asteroids.length; i++) {
            int ele = asteroids[i];
            boolean gone = false;

            while (top != -1 && stack[top] > 0 && ele < 0) {
                if (Math.abs(ele) > stack[top]) {
                    top--;          
                } else if (Math.abs(ele) == stack[top]) {
                    top--;         
                    gone = true;
                    break;
                } else {
                    gone = true;
                    break;
                }
            }

            if (!gone) {
                stack[++top] = ele;
            }
        }

        int[] ans = new int[top + 1];
        for (int i = 0; i <= top; i++) {
            ans[i] = stack[i];
        }

        return ans;
    }
}
