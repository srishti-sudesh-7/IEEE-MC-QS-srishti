class Solution {
    public int findTheWinner(int n, int k) {
        Queue<Integer> circle = new LinkedList<>();
        for(int i=1; i<=n;i++) circle.offer(i);

        while(circle.size()>1){
            for(int i=0;i<k-1;i++){
                int ele = circle.poll();
                circle.offer(ele);
                //System.out.println(ele);
            }
            circle.poll();
        }

        return circle.peek();
    }
}
